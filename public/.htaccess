<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # Handle React route /products without conflict from physical /products folder
  RewriteRule ^products/?$ /index.html [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule . /index.html [L]
</IfModule>
